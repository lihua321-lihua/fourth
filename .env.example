# DeepSeek API Key（真实调用必需）
# 从 https://platform.deepseek.com 获取
# 未配置时，/api/analyze 会降级为「示例问答数据」并在页面明确标注
# 真实 Key 请填到 .env.local（已被 .gitignore 忽略），不要贴到本文件
DEEPSEEK_API_KEY=

# 订阅/注册的 Postgres 连接串（Neon 或 Supabase 免费层）。
# 创建方式：在 Neon console 新建 project，复制连接串（含 ssl）粘贴到 .env.local 的同名变量。
# 例：postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=